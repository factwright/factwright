{
  "name": "@factwright/desktop",
  "productName": "Factwright",
  "version": "0.0.0",
  "private": true,
  "description": "The Factwright app for Mac and Windows.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.ts",
    "dev": "node scripts/dev.ts",
    "build": "vite build -c vite.main.config.ts && vite build -c vite.preload.config.ts && vite build -c vite.renderer.config.ts",
    "start": "electron .",
    "screens": "vite -c vite.renderer.config.ts",
    "typecheck": "tsc && tsc -p src/renderer",
    "test": "vitest run"
  },
  "devDependencies": {
    "@factwright/core": "workspace:*",
    "@factwright/ui": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "axe-core": "catalog:",
    "electron": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "node-pty": "catalog:"
  }
}
