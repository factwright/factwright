{
  "name": "@factwright/desktop",
  "productName": "Factwright",
  "version": "0.1.0",
  "private": true,
  "description": "The Factwright app for Mac and Windows.",
  "author": "Neatifai LLC",
  "homepage": "https://factwright.com",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.ts",
    "dev": "node scripts/dev.ts",
    "build": "vite build -c vite.main.config.ts && vite build -c vite.preload.config.ts && vite build -c vite.renderer.config.ts",
    "icon": "node scripts/icon.ts",
    "release-check": "node scripts/release-check.ts",
    "check-package": "node scripts/check-package.ts",
    "dist:mac": "electron-builder --config electron-builder.config.mjs --mac --publish never",
    "dist:win": "electron-builder --config electron-builder.config.mjs --win --publish never",
    "start": "electron .",
    "screens": "vite -c vite.renderer.config.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:packaged": "playwright test -c e2e/playwright.packaged.config.ts",
    "typecheck": "tsc && tsc -p src/renderer",
    "test": "vitest run"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@factwright/core": "workspace:*",
    "@factwright/engine": "workspace:*",
    "@factwright/server": "workspace:*",
    "@factwright/sync": "workspace:*",
    "@factwright/ui": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "axe-core": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-updater": "catalog:",
    "fflate": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "pdfjs-dist": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "uqr": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "node-pty": "catalog:"
  }
}
