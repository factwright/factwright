{
  "$schema": "node_modules/wrangler/config-schema.json",
  // factwright.com. The pages are static; the Worker sends www and plain http to
  // https://factwright.com and adds the security headers. Its first deploy sets up both addresses.
  "name": "factwright-site",
  // No usage data to Cloudflare from anyone running Wrangler here.
  "send_metrics": false,
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "routes": [
    { "pattern": "factwright.com", "custom_domain": true },
    { "pattern": "www.factwright.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Pages go through the Worker. Built files and template previews, most of each visit's
  // requests, skip it, so they don't count against the account's daily Worker requests, which
  // the sync server shares; public/_headers gives them their headers.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/assets/*", "!/templates/*"]
  },
  // Each download, by computer and version only, for the stats command (scripts/stats.ts).
  // Analytics Engine makes the dataset on its first write, and keeps each count for 3 months.
  "analytics_engine_datasets": [{ "binding": "DOWNLOADS", "dataset": "factwright_downloads" }],
  // The ideas board at /roadmap (worker/board.ts): suggestions, and votes with no account. Make the
  // database and apply its migrations before the first deploy that has it, as README.md says.
  "d1_databases": [
    { "binding": "IDEAS", "database_name": "factwright-feedback", "migrations_dir": "migrations" }
  ],
  // How often one address can suggest an idea, and vote, each minute. Cloudflare forgets the
  // address after that minute, and the Worker keeps none.
  "ratelimits": [
    { "name": "SUGGEST_LIMIT", "namespace_id": "190101", "simple": { "limit": 3, "period": 60 } },
    { "name": "VOTE_LIMIT", "namespace_id": "190102", "simple": { "limit": 30, "period": 60 } }
  ],
  // The Cloudflare Access application in front of /roadmap/admin, from its setup in Zero Trust:
  // the team's domain, such as factwright.cloudflareaccess.com, and the application's audience
  // (AUD) tag. Until both are set, the admin page lets no one in.
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" },
  // Logs keep only what the Worker writes itself. Cloudflare's log of every request is off.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
