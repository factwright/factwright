{
  "name": "@factwright/server",
  "version": "0.0.0",
  "private": true,
  "description": "The sync server: sign-in, and one private store of encrypted data per account, on Cloudflare.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./testing": "./test/server.ts"
  },
  "scripts": {
    "dev": "pnpm --filter @factwright/web build && wrangler dev --port 8787 --local-upstream localhost:8787",
    "deploy": "pnpm --filter @factwright/web build && wrangler deploy",
    "schema": "node scripts/accounts-schema.ts",
    "typecheck": "tsc && tsc -p test",
    "test": "vitest run"
  },
  "dependencies": {
    "@factwright/sync": "workspace:*",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
