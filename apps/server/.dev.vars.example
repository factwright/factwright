# Copy to .dev.vars for `pnpm dev`. Never commit .dev.vars.
# Where the app runs locally. Sign-in only trusts requests from here.
APP_URL=http://localhost:8787
# Any long random text works locally, such as the output of `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# A GitHub OAuth app whose callback is http://localhost:8787/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
