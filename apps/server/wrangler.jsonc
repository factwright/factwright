{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The sync server. Its first deploy creates the database and the file bucket on its own.
  "name": "factwright",
  // No usage data to Cloudflare from anyone running Wrangler here.
  "send_metrics": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "app.factwright.com", "custom_domain": true }],
  // The web view, built from apps/web. The API runs first; every other address is the web view.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_URL": "https://app.factwright.com",
    "STORAGE_LIMIT_MB": "1024"
  },
  // Accounts and sessions, for signing in.
  "d1_databases": [
    { "binding": "DB", "database_name": "factwright", "migrations_dir": "migrations" }
  ],
  // Each account's locked files, and its daily backups.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "factwright-files" }],
  // One store per account.
  "durable_objects": { "bindings": [{ "name": "STORES", "class_name": "UserStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserStore"] }],
  // The daily backup, at a quiet hour.
  "triggers": { "crons": ["17 4 * * *"] },
  // How much sync is used, in totals only: once a day, the daily job counts accounts and sign-ins
  // here, for the stats command in apps/site. Analytics Engine keeps each day's totals 3 months.
  "analytics_engine_datasets": [{ "binding": "SYNC_TOTALS", "dataset": "factwright_sync" }],
  // Logs keep only what the Worker writes itself, such as a backup that failed. Cloudflare's log
  // of every request is off, and any address it does record loses its query, which can carry a
  // sign-in code.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
